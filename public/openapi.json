{
  "openapi": "3.1.0",
  "info": {
    "title": "Planny Planny",
    "description": "Full conversational access to your Planny Planny household: todo items, meal plans, meal ideas, day events, meal outcomes, and the shopping list (store cupboard). You can list, create, update, complete, copy, move and delete — everything you can do in the app.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "https://<YOUR_PROJECT_REF>.supabase.co/functions/v1",
      "description": "Replace <YOUR_PROJECT_REF> with your Supabase project reference (found in Project Settings → General)"
    }
  ],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Supabase user JWT. Sign in via POST /auth/v1/token?grant_type=password with your email and password to obtain the access_token. See docs/chatgpt-plugin.md for the full setup guide."
      }
    },
    "schemas": {
      "Todo": {
        "type": "object",
        "properties": {
          "id":           { "type": "string", "format": "uuid" },
          "title":        { "type": "string" },
          "note":         { "type": ["string", "null"] },
          "date":         { "type": "string", "format": "date" },
          "completed_on": { "type": ["string", "null"], "format": "date" },
          "completed_at": { "type": ["string", "null"], "format": "date-time" },
          "user_id":      { "type": ["string", "null"], "format": "uuid" },
          "created_at":   { "type": "string", "format": "date-time" }
        }
      },
      "Meal": {
        "type": "object",
        "properties": {
          "id":          { "type": "string", "format": "uuid" },
          "date":        { "type": "string", "format": "date" },
          "title":       { "type": "string" },
          "description": { "type": ["string", "null"] },
          "created_at":  { "type": "string", "format": "date-time" }
        }
      },
      "Outcome": {
        "type": "object",
        "properties": {
          "id":           { "type": "string", "format": "uuid" },
          "meal_plan_id": { "type": "string", "format": "uuid" },
          "status":       { "type": "string", "enum": ["as_planned", "did_not_happen"] },
          "reason": {
            "type": ["string", "null"],
            "enum": ["no_shopping", "ate_out", "unexpected_event", "didnt_fancy_it", "other", null]
          },
          "note":         { "type": ["string", "null"] },
          "recorded_by":  { "type": ["string", "null"], "format": "uuid" },
          "created_at":   { "type": "string", "format": "date-time" },
          "updated_at":   { "type": "string", "format": "date-time" }
        }
      },
      "Idea": {
        "type": "object",
        "properties": {
          "id":          { "type": "string", "format": "uuid" },
          "title":       { "type": "string" },
          "description": { "type": ["string", "null"] },
          "date":        { "type": ["string", "null"], "format": "date" },
          "created_at":  { "type": "string", "format": "date-time" }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id":             { "type": "string", "format": "uuid" },
          "date":           { "type": "string", "format": "date" },
          "end_date":       { "type": ["string", "null"], "format": "date" },
          "event_name":     { "type": ["string", "null"] },
          "extra_adults":   { "type": "integer", "minimum": 0 },
          "extra_children": { "type": "integer", "minimum": 0 },
          "extra_babies":   { "type": "integer", "minimum": 0 },
          "created_at":     { "type": "string", "format": "date-time" }
        }
      },
      "ShoppingItem": {
        "type": "object",
        "properties": {
          "id":         { "type": "string", "format": "uuid" },
          "name":       { "type": "string" },
          "starred":    { "type": "boolean", "description": "Flagged as a staple the household always needs." },
          "warning":    { "type": "boolean", "description": "Flagged as something to watch out for (e.g. allergy)." },
          "meal_count": { "type": "integer" },
          "meals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "date":  { "type": "string", "format": "date" }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } },
        "required": ["error"]
      }
    },
    "parameters": {
      "householdId": {
        "name": "household_id",
        "in": "query",
        "description": "UUID of the household to act on. Defaults to the user's last active household (set automatically when you use the Planny Planny app).",
        "schema": { "type": "string", "format": "uuid" }
      },
      "resourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "dateFrom": {
        "name": "from",
        "in": "query",
        "description": "Start date, ISO 8601 (YYYY-MM-DD). Defaults to today.",
        "schema": { "type": "string", "format": "date" }
      },
      "dateTo": {
        "name": "to",
        "in": "query",
        "description": "End date, ISO 8601 (YYYY-MM-DD). Defaults to today + 6 days.",
        "schema": { "type": "string", "format": "date" }
      }
    }
  },
  "paths": {

    "/chatgpt-plugin/todos": {
      "get": {
        "operationId": "listTodos",
        "summary": "List household todo items",
        "description": "Returns incomplete todo items by default. Pass completed=true to see ticked-off items instead.",
        "parameters": [
          { "$ref": "#/components/parameters/householdId" },
          {
            "name": "completed",
            "in": "query",
            "description": "Omit or false for open todos; true for completed.",
            "schema": { "type": "string", "enum": ["true", "false"] }
          }
        ],
        "responses": {
          "200": { "description": "List of todos", "content": { "application/json": { "schema": { "type": "object", "properties": { "todos": { "type": "array", "items": { "$ref": "#/components/schemas/Todo" } } } } } } },
          "401": { "description": "Unauthorised", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "post": {
        "operationId": "createTodo",
        "summary": "Create a todo item",
        "parameters": [{ "$ref": "#/components/parameters/householdId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["title"], "properties": {
            "title": { "type": "string" },
            "date":  { "type": "string", "format": "date", "description": "Defaults to today." },
            "note":  { "type": "string" }
          } } } }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "type": "object", "properties": { "todo": { "$ref": "#/components/schemas/Todo" } } } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },

    "/chatgpt-plugin/todos/{id}": {
      "patch": {
        "operationId": "updateTodo",
        "summary": "Update a todo's title, date or note",
        "parameters": [
          { "$ref": "#/components/parameters/resourceId" },
          { "$ref": "#/components/parameters/householdId" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": {
            "title": { "type": "string" },
            "date":  { "type": "string", "format": "date" },
            "note":  { "type": ["string", "null"] }
          } } } }
        },
        "responses": {
          "200": { "description": "Updated todo", "content": { "application/json": { "schema": { "type": "object", "properties": { "todo": { "$ref": "#/components/schemas/Todo" } } } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "delete": {
        "operationId": "deleteTodo",
        "summary": "Permanently delete a todo item",
        "parameters": [
          { "$ref": "#/components/parameters/resourceId" },
          { "$ref": "#/components/parameters/householdId" }
        ],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "type": "object", "properties": { "deleted": { "type": "boolean" } } } } } }
        }
      }
    },

    "/chatgpt-plugin/todos/{id}/complete": {
      "post": {
        "operationId": "completeTodo",
        "summary": "Mark a todo as done",
        "parameters": [
          { "$ref": "#/components/parameters/resourceId" },
          { "$ref": "#/components/parameters/householdId" }
        ],
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "object", "properties": {
            "completed_on": { "type": "string", "format": "date", "description": "Defaults to today." }
          } } } }
        },
        "responses": {
          "200": { "description": "Completed todo", "content": { "application/json": { "schema": { "type": "object", "properties": { "todo": { "$ref": "#/components/schemas/Todo" } } } } } }
        }
      }
    },

    "/chatgpt-plugin/todos/{id}/reopen": {
      "post": {
        "operationId": "reopenTodo",
        "summary": "Un-tick a completed todo (reopen it)",
        "parameters": [
          { "$ref": "#/components/parameters/resourceId" },
          { "$ref": "#/components/parameters/householdId" }
        ],
        "responses": {
          "200": { "description": "Reopened todo", "content": { "application/json": { "schema": { "type": "object", "properties": { "todo": { "$ref": "#/components/schemas/Todo" } } } } } }
        }
      }
    },

    "/chatgpt-plugin/meals": {
      "get": {
        "operationId": "listMeals",
        "summary": "List planned meals",
        "description": "Returns meals in the given date range (default: today + 6 days).",
        "parameters": [
          { "$ref": "#/components/parameters/householdId" },
          { "$ref": "#/components/parameters/dateFrom" },
          { "$ref": "#/components/parameters/dateTo" }
        ],
        "responses": {
          "200": { "description": "List of meals", "content": { "application/json": { "schema": { "type": "object", "properties": { "meals": { "type": "array", "items": { "$ref": "#/components/schemas/Meal" } } } } } } }
        }
      },
      "post": {
        "operationId": "createMeal",
        "summary": "Add a meal to the plan",
        "parameters": [{ "$ref": "#/components/parameters/householdId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["title"], "properties": {
            "title":       { "type": "string" },
            "date":        { "type": "string", "format": "date", "description": "Defaults to today." },
            "description": { "type": "string" }
          } } } }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "type": "object", "properties": { "meal": { "$ref": "#/components/schemas/Meal" } } } } } }
        }
      }
    },

    "/chatgpt-plugin/meals/{id}": {
      "patch": {
        "operationId": "updateMeal",
        "summary": "Update a meal's title, date or description",
        "parameters": [
          { "$ref": "#/components/parameters/resourceId" },
          { "$ref": "#/components/parameters/householdId" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": {
            "title":       { "type": "string" },
            "date":        { "type": "string", "format": "date" },
            "description": { "type": ["string", "null"] }
          } } } }
        },
        "responses": {
          "200": { "description": "Updated meal", "content": { "application/json": { "schema": { "type": "object", "properties": { "meal": { "$ref": "#/components/schemas/Meal" } } } } } }
        }
      },
      "delete": {
        "operationId": "deleteMeal",
        "summary": "Delete a planned meal",
        "parameters": [
          { "$ref": "#/components/parameters/resourceId" },
          { "$ref": "#/components/parameters/householdId" }
        ],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "type": "object", "properties": { "deleted": { "type": "boolean" } } } } } }
        }
      }
    },

    "/chatgpt-plugin/meals/{id}/copy": {
      "post": {
        "operationId": "copyOrMoveMeal",
        "summary": "Copy (or move) a meal to another date",
        "description": "Creates a copy of the meal on target_date, preserving ingredient links. Set move=true to also delete the original (i.e. reschedule).",
        "parameters": [
          { "$ref": "#/components/parameters/resourceId" },
          { "$ref": "#/components/parameters/householdId" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["target_date"], "properties": {
            "target_date": { "type": "string", "format": "date" },
            "move":        { "type": "boolean", "description": "If true, delete the original (reschedule). Default false (copy)." }
          } } } }
        },
        "responses": {
          "201": { "description": "Copied/moved meal", "content": { "application/json": { "schema": { "type": "object", "properties": {
            "meal":  { "$ref": "#/components/schemas/Meal" },
            "moved": { "type": "boolean" }
          } } } } }
        }
      }
    },

    "/chatgpt-plugin/outcomes": {
      "get": {
        "operationId": "listOutcomes",
        "summary": "List meal outcomes (did they actually happen?)",
        "parameters": [
          { "$ref": "#/components/parameters/householdId" },
          { "$ref": "#/components/parameters/dateFrom" },
          { "$ref": "#/components/parameters/dateTo" }
        ],
        "responses": {
          "200": { "description": "List of outcomes", "content": { "application/json": { "schema": { "type": "object", "properties": { "outcomes": { "type": "array", "items": { "$ref": "#/components/schemas/Outcome" } } } } } } }
        }
      }
    },

    "/chatgpt-plugin/outcomes/{meal_id}": {
      "put": {
        "operationId": "upsertOutcome",
        "summary": "Record or update an outcome for a meal",
        "description": "Use status=as_planned when the meal happened. Use did_not_happen with an optional reason and note when it didn't.",
        "parameters": [
          { "name": "meal_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "$ref": "#/components/parameters/householdId" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": {
            "status": { "type": "string", "enum": ["as_planned", "did_not_happen"] },
            "reason": { "type": "string", "enum": ["no_shopping", "ate_out", "unexpected_event", "didnt_fancy_it", "other"] },
            "note":   { "type": "string" }
          } } } }
        },
        "responses": {
          "200": { "description": "Upserted outcome", "content": { "application/json": { "schema": { "type": "object", "properties": { "outcome": { "$ref": "#/components/schemas/Outcome" } } } } } }
        }
      },
      "delete": {
        "operationId": "deleteOutcome",
        "summary": "Clear the outcome for a meal (mark as unrecorded)",
        "parameters": [
          { "name": "meal_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "$ref": "#/components/parameters/householdId" }
        ],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "type": "object", "properties": { "deleted": { "type": "boolean" } } } } } }
        }
      }
    },

    "/chatgpt-plugin/ideas": {
      "get": {
        "operationId": "listIdeas",
        "summary": "List meal ideas backlog",
        "description": "Returns the household's meal idea backlog (most recent first, up to 50).",
        "parameters": [{ "$ref": "#/components/parameters/householdId" }],
        "responses": {
          "200": { "description": "List of ideas", "content": { "application/json": { "schema": { "type": "object", "properties": { "ideas": { "type": "array", "items": { "$ref": "#/components/schemas/Idea" } } } } } } }
        }
      },
      "post": {
        "operationId": "createIdea",
        "summary": "Propose a meal idea",
        "parameters": [{ "$ref": "#/components/parameters/householdId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["title"], "properties": {
            "title":       { "type": "string" },
            "description": { "type": "string" },
            "date":        { "type": "string", "format": "date", "description": "Optional — pin the idea to a specific date." }
          } } } }
        },
        "responses": {
          "201": { "description": "Created idea", "content": { "application/json": { "schema": { "type": "object", "properties": { "idea": { "$ref": "#/components/schemas/Idea" } } } } } }
        }
      }
    },

    "/chatgpt-plugin/ideas/{id}": {
      "delete": {
        "operationId": "deleteIdea",
        "summary": "Delete a meal idea",
        "parameters": [
          { "$ref": "#/components/parameters/resourceId" },
          { "$ref": "#/components/parameters/householdId" }
        ],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "type": "object", "properties": { "deleted": { "type": "boolean" } } } } } }
        }
      }
    },

    "/chatgpt-plugin/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "List upcoming events (visitors, schedule changes)",
        "parameters": [
          { "$ref": "#/components/parameters/householdId" },
          { "$ref": "#/components/parameters/dateFrom" },
          { "$ref": "#/components/parameters/dateTo" }
        ],
        "responses": {
          "200": { "description": "List of events", "content": { "application/json": { "schema": { "type": "object", "properties": { "events": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } } } } } } }
        }
      },
      "post": {
        "operationId": "createEvent",
        "summary": "Create a day event",
        "description": "Records an event or visitor for a day (or date range). Extra headcount fields adjust the planning numbers shown in the app.",
        "parameters": [{ "$ref": "#/components/parameters/householdId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": {
            "date":           { "type": "string", "format": "date", "description": "Defaults to today." },
            "end_date":       { "type": "string", "format": "date", "description": "Optional end date for multi-day events." },
            "event_name":     { "type": "string" },
            "extra_adults":   { "type": "integer", "minimum": 0, "default": 0 },
            "extra_children": { "type": "integer", "minimum": 0, "default": 0 },
            "extra_babies":   { "type": "integer", "minimum": 0, "default": 0 }
          } } } }
        },
        "responses": {
          "201": { "description": "Created event", "content": { "application/json": { "schema": { "type": "object", "properties": { "event": { "$ref": "#/components/schemas/Event" } } } } } }
        }
      }
    },

    "/chatgpt-plugin/events/{id}": {
      "patch": {
        "operationId": "updateEvent",
        "summary": "Update a day event",
        "parameters": [
          { "$ref": "#/components/parameters/resourceId" },
          { "$ref": "#/components/parameters/householdId" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": {
            "date":           { "type": "string", "format": "date" },
            "end_date":       { "type": ["string", "null"], "format": "date" },
            "event_name":     { "type": ["string", "null"] },
            "extra_adults":   { "type": "integer", "minimum": 0 },
            "extra_children": { "type": "integer", "minimum": 0 },
            "extra_babies":   { "type": "integer", "minimum": 0 }
          } } } }
        },
        "responses": {
          "200": { "description": "Updated event", "content": { "application/json": { "schema": { "type": "object", "properties": { "event": { "$ref": "#/components/schemas/Event" } } } } } }
        }
      },
      "delete": {
        "operationId": "deleteEvent",
        "summary": "Delete a day event",
        "parameters": [
          { "$ref": "#/components/parameters/resourceId" },
          { "$ref": "#/components/parameters/householdId" }
        ],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "type": "object", "properties": { "deleted": { "type": "boolean" } } } } } }
        }
      }
    },

    "/chatgpt-plugin/shopping-list": {
      "get": {
        "operationId": "getShoppingList",
        "summary": "Get the shopping list (store cupboard)",
        "description": "Returns all ingredients linked to upcoming meal plans, sorted alphabetically with back-references to which meals need them. Mirrors the Store Cupboard screen in the app.",
        "parameters": [
          { "$ref": "#/components/parameters/householdId" },
          {
            "name": "from",
            "in": "query",
            "description": "Start date. Defaults to today.",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "description": "End date. Defaults to far future (all planned meals).",
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": { "description": "Shopping list", "content": { "application/json": { "schema": { "type": "object", "properties": { "shopping_list": { "type": "array", "items": { "$ref": "#/components/schemas/ShoppingItem" } } } } } } }
        }
      }
    }

  }
}

  "servers": [
    {
      "url": "https://<YOUR_PROJECT_REF>.supabase.co/functions/v1",
      "description": "Replace <YOUR_PROJECT_REF> with your Supabase project reference"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Supabase user JWT. Obtain one by signing in via the Supabase Auth REST API (see docs/chatgpt-plugin.md)."
      }
    },
    "schemas": {
      "Todo": {
        "type": "object",
        "properties": {
          "id":           { "type": "string", "format": "uuid" },
          "title":        { "type": "string" },
          "note":         { "type": ["string", "null"] },
          "date":         { "type": "string", "format": "date" },
          "completed_on": { "type": ["string", "null"], "format": "date" },
          "user_id":      { "type": ["string", "null"], "format": "uuid" },
          "created_at":   { "type": "string", "format": "date-time" }
        }
      },
      "Meal": {
        "type": "object",
        "properties": {
          "id":          { "type": "string", "format": "uuid" },
          "date":        { "type": "string", "format": "date" },
          "title":       { "type": "string" },
          "description": { "type": ["string", "null"] },
          "created_at":  { "type": "string", "format": "date-time" }
        }
      },
      "Idea": {
        "type": "object",
        "properties": {
          "id":          { "type": "string", "format": "uuid" },
          "title":       { "type": "string" },
          "description": { "type": ["string", "null"] },
          "date":        { "type": ["string", "null"], "format": "date" },
          "created_at":  { "type": "string", "format": "date-time" }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id":             { "type": "string", "format": "uuid" },
          "date":           { "type": "string", "format": "date" },
          "event_name":     { "type": ["string", "null"] },
          "extra_adults":   { "type": "integer" },
          "extra_children": { "type": "integer" },
          "created_at":     { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        },
        "required": ["error"]
      }
    }
  },
  "paths": {
    "/chatgpt-plugin/todos": {
      "get": {
        "operationId": "listTodos",
        "summary": "List household todo items",
        "description": "Returns incomplete household-level todo items by default. Pass completed=true to see ticked-off items instead.",
        "parameters": [
          {
            "name": "household_id",
            "in": "query",
            "description": "UUID of the household. Defaults to the user's last active household.",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "completed",
            "in": "query",
            "description": "Filter by completion state. Omit or set to false for open todos; true for completed.",
            "schema": { "type": "string", "enum": ["true", "false"] }
          }
        ],
        "responses": {
          "200": {
            "description": "List of todo items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "todos": { "type": "array", "items": { "$ref": "#/components/schemas/Todo" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorised", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "post": {
        "operationId": "createTodo",
        "summary": "Create a todo item",
        "description": "Adds a new household-level todo item for the given date.",
        "parameters": [
          {
            "name": "household_id",
            "in": "query",
            "description": "UUID of the household. Defaults to the user's last active household.",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string", "description": "Short description of the task." },
                  "date":  { "type": "string", "format": "date", "description": "ISO date the todo is pinned to. Defaults to today." },
                  "note":  { "type": "string", "description": "Optional longer note." }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created todo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "todo": { "$ref": "#/components/schemas/Todo" } }
                }
              }
            }
          },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Unauthorised", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/chatgpt-plugin/meals": {
      "get": {
        "operationId": "listMeals",
        "summary": "List meal plans",
        "description": "Returns planned meals for the given date range (default: today + 6 days).",
        "parameters": [
          {
            "name": "household_id",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Start date (ISO 8601). Defaults to today.",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "description": "End date (ISO 8601). Defaults to today + 6 days.",
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of meal plan entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meals": { "type": "array", "items": { "$ref": "#/components/schemas/Meal" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorised", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "post": {
        "operationId": "createMeal",
        "summary": "Add a meal to the plan",
        "description": "Creates a new meal plan entry for a specific date.",
        "parameters": [
          {
            "name": "household_id",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "date"],
                "properties": {
                  "title":       { "type": "string" },
                  "date":        { "type": "string", "format": "date" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created meal plan entry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "meal": { "$ref": "#/components/schemas/Meal" } }
                }
              }
            }
          },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Unauthorised", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/chatgpt-plugin/ideas": {
      "get": {
        "operationId": "listIdeas",
        "summary": "List meal ideas",
        "description": "Returns the household's meal idea backlog (most recent first, up to 50).",
        "parameters": [
          {
            "name": "household_id",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of meal ideas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ideas": { "type": "array", "items": { "$ref": "#/components/schemas/Idea" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorised", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "post": {
        "operationId": "createIdea",
        "summary": "Propose a meal idea",
        "description": "Adds a new meal idea to the household backlog. Optionally pin it to a date.",
        "parameters": [
          {
            "name": "household_id",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title":       { "type": "string" },
                  "description": { "type": "string" },
                  "date":        { "type": "string", "format": "date", "description": "Optional date to pin the idea to." }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created meal idea",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "idea": { "$ref": "#/components/schemas/Idea" } }
                }
              }
            }
          },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Unauthorised", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/chatgpt-plugin/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "List upcoming events",
        "description": "Returns day-context events (visitors, schedule changes) for the given date range (default: today + 6 days).",
        "parameters": [
          {
            "name": "household_id",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Start date (ISO 8601). Defaults to today.",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "description": "End date (ISO 8601). Defaults to today + 6 days.",
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorised", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  }
}
